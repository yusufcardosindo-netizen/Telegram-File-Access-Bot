# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Telegram User ID (get it from @userinfobot or @raw_data_bot on Telegram)
# Multiple admin IDs can be separated by commas, e.g. 12345678,87654321
ADMIN_IDS=

# Time in seconds before the sent file self-destructs (300 seconds = 5 minutes)
DESTRUCT_TIME_SECONDS=300

# Watermark branding configuration
WATERMARK_TEXT=Made by @VIJAYEDITOR77 on Telegram
WATERMARK_USERNAME=@VIJAYEDITOR77
